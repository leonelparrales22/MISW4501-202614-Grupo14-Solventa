# --- Postgres ---
# Local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/siniestros_db?sslmode=disable
# AWS RDS
# DATABASE_URL=postgres://usuario:password@tu-instancia.rds.amazonaws.com:5432/siniestros_db?sslmode=require

# --- Redis (caché de lectura) ---
# Local
REDIS_URL=redis://localhost:6379/0
# AWS ElastiCache con TLS
# REDIS_URL=rediss://tu-cluster.cache.amazonaws.com:6379/0

# Tiempo máximo de espera de una lectura a Postgres antes de degradar a caché.
DB_QUERY_TIMEOUT_MS=900

# Tiempo máximo para escrituras (crear/actualizar). Las escrituras no degradan.
DB_WRITE_TIMEOUT_MS=5000

# Tiempo de vida de cada entrada en Redis (24h por defecto).
CACHE_TTL_SECONDS=86400

# Latencia artificial añadida a cada LECTURA contra Postgres.
# Poner un valor mayor que DB_QUERY_TIMEOUT_MS (ej. 1500) para probar el
# modo degradado sin necesidad de que Postgres esté realmente lento.
SIMULATED_DB_LATENCY_MS=0

# Dirección donde escucha el servidor HTTP.
ADDR=:8080
